  ],
  "grammar": [
    {"title": "〜にとって", "meaning_ko": "〜에게 있어서", "meaning_en": "for, from the viewpoint of", "meaning_zh": "对于…来说", "ex_ja": "私にとって家族が一番大切です。", "ex_ko": "나에게 있어서 가족이 가장 소중하다.", "ex_en": "For me, family is the most important.", "ex_zh": "对我来说家人最重要。", "note_ko": "사람·입장을 나타냄.", "note_en": "Indicates perspective.", "note_zh": "表达立场或观点。"},
    {"title": "〜にしては", "meaning_ko": "〜치고는", "meaning_en": "for, considering", "meaning_zh": "作为…来说", "ex_ja": "新人にしては仕事が早い。", "ex_ko": "신입치고는 일이 빠르다.", "ex_en": "Fast worker for a newbie.", "ex_zh": "作为新人来说工作很快。", "note_ko": "예상과 다른 결과를 표현.", "note_en": "Expresses unexpected result.", "note_zh": "表示与预期不同。"},
    {"title": "〜とともに", "meaning_ko": "〜와 함께, 〜와 동시에", "meaning_en": "together with, as", "meaning_zh": "随着…", "ex_ja": "時代の変化とともに価値観も変わる。", "ex_ko": "시대의 변화와 함께 가치관도 변한다.", "ex_en": "Values change along with the times.", "ex_zh": "随着时代变化价值观也在变。", "note_ko": "변화의 동반·동시 발생.", "note_en": "Co-occurrence of change.", "note_zh": "同步发生的变化。"},
    {"title": "〜くせに", "meaning_ko": "〜인 주제에", "meaning_en": "even though, despite", "meaning_zh": "明明…却", "ex_ja": "知らないくせに偉そうに言う。", "ex_ko": "모르는 주제에 잘난 듯 말한다.", "ex_en": "He talks big though he doesn't know.", "ex_zh": "明明不知道却说得很自大。", "note_ko": "비난의 뉘앙스 포함.", "note_en": "Contains nuance of criticism.", "note_zh": "含有指责语气。"},
    {"title": "〜ものの", "meaning_ko": "〜이지만, 〜이긴 하지만", "meaning_en": "although", "meaning_zh": "虽然…但是", "ex_ja": "免許は取ったものの、運転しない。", "ex_ko": "면허는 땄지만 운전은 하지 않는다.", "ex_en": "Although I got my license, I don't drive.", "ex_zh": "虽然取得了驾照,但不开车。", "note_ko": "사실은 인정하나 결과는 다름.", "note_en": "Acknowledges fact but result differs.", "note_zh": "承认事实但结果不同。"},
    {"title": "〜どころか", "meaning_ko": "〜은커녕", "meaning_en": "far from, let alone", "meaning_zh": "别说…就连", "ex_ja": "返事どころか連絡もない。", "ex_ko": "답장은커녕 연락도 없다.", "ex_en": "Not even a message, let alone a reply.", "ex_zh": "别说回信,连联系都没有。", "note_ko": "예상과 정반대 강조.", "note_en": "Emphasizes opposite of expected.", "note_zh": "强调与预期相反。"},
    {"title": "〜ばかりか", "meaning_ko": "〜뿐만 아니라", "meaning_en": "not only, but also", "meaning_zh": "不仅…而且", "ex_ja": "成績ばかりか性格もいい。", "ex_ko": "성적뿐만 아니라 성격도 좋다.", "ex_en": "Not only grades, but also personality is good.", "ex_zh": "不仅成绩好,性格也好。", "note_ko": "추가 정보를 더할 때.", "note_en": "Adds further information.", "note_zh": "用于追加信息。"},
    {"title": "〜にもかかわらず", "meaning_ko": "〜에도 불구하고", "meaning_en": "despite, in spite of", "meaning_zh": "尽管…", "ex_ja": "雨にもかかわらず試合は続いた。", "ex_ko": "비에도 불구하고 시합은 계속됐다.", "ex_en": "Despite the rain, the match continued.", "ex_zh": "尽管下雨比赛仍在继续。", "note_ko": "역접의 강한 형태.", "note_en": "Strong contrastive form.", "note_zh": "强烈的转折形式。"},
    {"title": "〜にすぎない", "meaning_ko": "〜에 불과하다", "meaning_en": "merely, no more than", "meaning_zh": "不过是…", "ex_ja": "これは個人の意見にすぎない。", "ex_ko": "이것은 개인의 의견에 불과하다.", "ex_en": "This is merely a personal opinion.", "ex_zh": "这不过是个人意见。", "note_ko": "한정·축소의 의미.", "note_en": "Limitation/diminishment.", "note_zh": "表示限定。"},
